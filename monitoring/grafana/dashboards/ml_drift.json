{
  "uid": "ml-drift",
  "title": "Monitoring ML : drift des données",
  "description": "Résultats du DAG monitoring_evidently (production vs référence du champion).",
  "tags": [
    "ml",
    "evidently"
  ],
  "timezone": "Europe/Paris",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
