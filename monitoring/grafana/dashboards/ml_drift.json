  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Âge du dernier calcul Evidently",
      "description": "Âge du calcul du champion actuel. Une série absente signifie qu'il n'a pas encore été évalué. Un âge élevé peut aussi venir d'un run ignoré faute de prédictions, pas forcément d'un échec.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max(ml_monitoring_computed_timestamp_seconds{metric=\"part_colonnes_en_drift\",feature=\"\"} and on(model_version) ml_model_score{score=\"mae\",champion=\"true\"})",
          "legendFormat": "__auto",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 129600
              },
              {
                "color": "red",
                "value": 216000
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
