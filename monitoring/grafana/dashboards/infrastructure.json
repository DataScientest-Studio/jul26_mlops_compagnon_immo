{
  "uid": "immo-infrastructure",
  "title": "Infrastructure : hôte et services",
  "description": "PostgreSQL, hôte Linux, conteneurs, Airflow, MLflow serveur et MinIO. Aucun score métier d'entraînement.",
  "tags": [
    "infrastructure",
    "compagnon"
  ],
  "timezone": "Europe/Paris",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Disponibilité des cibles",
      "type": "timeseries",
      "description": "up indique le succès de lecture des métriques, pas une disponibilité métier.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=~\"postgres|node|cadvisor|airflow_statsd|mlflow_server|minio|inference_api|sql_exporter\"}",
          "legendFormat": "{{job}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "PostgreSQL : connexion à la base",
      "type": "timeseries",
      "description": "pg_up valide la connexion SQL, contrairement au simple up de l'exporter.",
